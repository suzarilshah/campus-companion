{
  "name": "campus-companion",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx server/index.ts",
    "start": "tsx server/index.ts --production",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "build": "vite build",
    "test:e2e": "playwright test",
    "check:clean": "node scripts/check-clean-install.mjs",
    "contract:snapshot": "node scripts/snapshot-contract.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run test:e2e",
    "db:verify": "tsx scripts/verify-neon.mjs"
  },
  "dependencies": {
    "@neon/config": "^1.8.2",
    "@neon/env": "^1.4.7",
    "@neondatabase/serverless": "1.1.0",
    "@react-three/fiber": "9.8.1",
    "express": "5.2.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "0.180.0",
    "@vitejs/plugin-react": "6.1.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  }
}
