# Copy to .env (git-ignored) and fill in. Never commit .env or paste its values into chat or issues.
# Neon Postgres connection string for EXP progress (Neon console → Connect → "Connection string").
# Leave unset to store progress in the git-ignored local file .local/progress.json instead.
DATABASE_URL=

# ── Optional AI suggestions (local app only; see docs/ai-plan.md) ──────────────────────────────
# Leave AI_PROVIDER empty to keep AI off: the panels then show labelled keyword matches instead.
# Credentials come from your own AWS profile via the SDK chain. Never put access keys in this file.
AI_PROVIDER=            # bedrock | sagemaker
AI_AWS_PROFILE=         # a named profile in ~/.aws/config (run `aws sso login --profile <name>` first)
AI_AWS_REGION=us-east-1
# Amazon Bedrock (Converse API). Enable model access in the console first.
BEDROCK_MODEL_ID=       # e.g. a Claude or Nova model ID / inference profile available in your region
BEDROCK_GUARDRAIL_ID=   # optional but recommended: denied topics, PII and prompt-attack filters
BEDROCK_GUARDRAIL_VERSION=DRAFT
# Amazon SageMaker real-time endpoint (e.g. your Kimi deployment)
SAGEMAKER_ENDPOINT=
SAGEMAKER_FORMAT=openai # openai = {messages,…} (vLLM/LMI/SGLang) · tgi = {inputs,parameters}
